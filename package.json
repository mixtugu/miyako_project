{
  "name": "miyako_project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "start": "wrangler dev",
    "dev:worker": "wrangler dev",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "check:deploy": "node --env-file-if-exists=.dev.vars scripts/check-deployment.mjs",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && node --env-file-if-exists=.dev.vars scripts/deploy.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "data:export": "node --env-file-if-exists=.env.export --env-file-if-exists=.env scripts/export-supabase.mjs",
    "data:verify": "node scripts/verify-import.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
