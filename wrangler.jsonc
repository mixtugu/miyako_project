{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "miyako-project",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "miyako-gallery",
    "database_id": "100a42b9-341e-4912-aa66-ae529bccac5b",
    "migrations_dir": "migrations"
  }],
  "durable_objects": { "bindings": [{ "name": "GALLERY_ROOMS", "class_name": "GalleryRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GalleryRoom"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health"]
  },
  "ratelimits": [
    { "name": "COMMENT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "POSITION_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "DELETE_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "READ_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 1200, "period": 60 } },
    { "name": "SOCKET_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
