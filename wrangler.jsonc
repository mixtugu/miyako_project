{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "miyako-project",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "miyako-gallery",
    "database_id": "100a42b9-341e-4912-aa66-ae529bccac5b",
    "migrations_dir": "migrations"
  }],
  "durable_objects": { "bindings": [{ "name": "GALLERY_ROOMS", "class_name": "GalleryRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GalleryRoom"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health"]
  },
  "observability": { "enabled": false }
}
